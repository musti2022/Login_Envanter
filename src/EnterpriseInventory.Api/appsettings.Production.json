{
  "ActiveDirectory": {
    "Mode": "Ldap",
    "Domain": "CHANGE-ME.local",
    "ServerFqdn": "dc01.CHANGE-ME.local",
    "Port": 636,
    "UseLdaps": true,
    "BaseDn": "DC=CHANGE-ME,DC=local",
    "AllowedGroupSid": "CHANGE-ME",
    "NestedGroupPolicy": "DirectMembershipOnly",
    "ServiceAccountUserName": "CHANGE-ME",
    "CheckCertificateRevocation": true
  },
  "DataProtection": {
    "KeysDirectory": "D:\\EnterpriseInventory\\DataProtection-Keys"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:\\Logs\\EnterpriseInventory\\log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "envanter.CHANGE-ME.local"
}
