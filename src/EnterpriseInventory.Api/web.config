<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for the published API and React app (one site, in-process hosting, app pool "No Managed Code").
  dotnet publish fills in processPath and arguments. Secrets never go here: the file is replaced on every deployment
  and is readable by the site. They are set as environment variables of the site in IIS (deploy/iis/README.md).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\EnterpriseInventory.Api.dll" hostingModel="inprocess" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- The API answers its own errors (Turkish problem+json); IIS must not replace them with its pages. -->
      <httpErrors existingResponse="PassThrough" />
      <security>
        <!-- No request of this application is larger than a few kilobytes; 1 MB leaves room and refuses floods. -->
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="1048576" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
