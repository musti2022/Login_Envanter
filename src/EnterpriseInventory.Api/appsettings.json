{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ActiveDirectory": {
    "Mode": "Ldap",
    "Domain": "",
    "ServerFqdn": "",
    "Port": 636,
    "UseLdaps": true,
    "BaseDn": "",
    "EmployeeSearchBaseDn": "",
    "AllowedGroupName": "Bim_Envanter",
    "AllowedGroupSid": "",
    "NestedGroupPolicy": "DirectMembershipOnly",
    "ServiceAccountUserName": "",
    "ServiceAccountPassword": "",
    "TrustedCaCertificatePath": "",
    "CheckCertificateRevocation": true,
    "ConnectTimeoutSeconds": 10,
    "OperationTimeoutSeconds": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Session": {
    "IdleTimeoutMinutes": 20,
    "AbsoluteTimeoutHours": 8,
    "AccessRecheckMinutes": 5,
    "DirectoryOutageGraceMinutes": 15
  },
  "DataProtection": {
    "KeysDirectory": ""
  },
  "Realtime": {
    "SessionCheckInterval": "00:00:30"
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "WindowSeconds": 60,
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60
  },
  "AllowedHosts": "*"
}
